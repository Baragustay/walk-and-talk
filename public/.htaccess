# Walk & Talk on Hostinger (Apache / LiteSpeed). Netlify ignores this file.
Options -MultiViews
RewriteEngine On

# Send http to https (the X-Forwarded-Proto check avoids a loop behind a proxy).
# The microphone only works over https.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# The app asks for tokens at the Netlify path; on Hostinger the PHP file answers.
RewriteRule ^\.netlify/functions/live-token$ api/live-token.php [L]

# Serve real files and folders as they are
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else goes to index.html (React Router handles /call, /words, ...)
RewriteRule ^ index.html [L]

# Hashed build assets can be cached for a long time; index.html never
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
